# ======================== STATIC ========================
# Port the server listens on
PORT=10000

# Enforce wss:// (TLS) connections only. When this var is absent the
# server default is TRUE (fail-closed); set it to false explicitly to
# allow plaintext ws:// (e.g. localhost-only or onion-only deployments).
REQUIRE_TLS=true

# Allowed CORS origins (comma-separated). Origin is a browser-only
# header: the desktop client sends none, and the server allows that
# (Origin exists to stop a web page from hijacking a session, not to
# authenticate clients). A browser page's WebSocket handshake is
# rejected unless its Origin matches an entry here, so list every
# address the web client is served from. Browsers treat localhost and
# 127.0.0.1 as different origins, hence both loopback defaults (for the
# bundled webterm bundle or a first local run); they grant no access to
# outside pages. Add your real domain for production, e.g.
# https://chat.example.com — an entry accepts that origin only, so list
# exactly the hosts you serve the web client from.
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Unique identifier for this instance
INSTANCE_ID=your-instance-id

# Timezone for timestamps
TIMEZONE=Asia/Ho_Chi_Minh

# Data root for generated files (identity, webauthn store, history,
# log). Individual paths below still win when set. Defaults to
# <instance>/data when unset.
DATA_DIR=./data

# Log file path
LOG_FILE_PATH=./data/app.log

# Max log file size before rotation (MB)
MAX_LOG_SIZE_MB=50

# History file path (RFC3339Nano ts, wire JSON; .old is zstd-compressed to .old.zst)
HISTORY_FILE_PATH=./data/history.jsonl

# Max history file size before rotation (MB, raw; .old is zstd ~3MB for 50MB)
MAX_HISTORY_FILE_SIZE_MB=50

# ======================== CONTENT PRIVACY ========================
# NO_CONTENT_LOGS is a content-privacy policy, NOT "zero logs".
# true  -> chat history lives in RAM only (nothing is appended to
#          HISTORY_FILE_PATH, no rotation, no disk lookup) and message
#          content is never logged (no per-message line, rejected payloads
#          are logged by error type only).
#          Operational metadata is still logged to stdout/stderr: client
#          IP, auth/identity events, admin and error lines. Identity and
#          auth files are still written (server_identity.json,
#          webauthn.json, config/roles.json).
# false -> default: history persists to HISTORY_FILE_PATH and logs append
#          to LOG_FILE_PATH.
# LOG_FILE_PATH and HISTORY_FILE_PATH are ignored while this is true.
# Existing history/log files are left untouched: remove them manually, and
# disable log persistence at the OS level (e.g. journald) for a full
# no-content-retention deployment.
NO_CONTENT_LOGS=false

# ======================== DYNAMIC ========================
# The three URLs below only feed the status page. Optional: when one is
# empty its line is simply omitted (the server still boots).
# Public server status page
STATUS_URL=https://example.com/status

# Client download link
DOWNLOAD_URL=https://example.com/download

# Instance homepage
HOMEPAGE_URL=https://example.com/

# Max simultaneous connections per IP
MAX_CONNECTIONS_PER_IP=2

# Min delay between connections from the same IP
CONNECTION_COOLDOWN=5s

# Min delay between messages (anti-spam)
MESSAGE_COOLDOWN=200ms

# Disconnect clients that do not send any chat message for too long (0 to disable)
IDLE_CHAT_TIMEOUT=30m

# Max characters per message
MAX_MESSAGE_LENGTH=5000

# Max lines per message
MAX_MESSAGE_LINE=50

# Max display name length
MAX_USERNAME_LENGTH=12

# Max tripcode length
MAX_TRIPCODE_LENGTH=64

# Max chat history size in bytes (10 MB, in-memory ChatHistory, cap shrink when cap>4*len)
MAX_HISTORY_BYTES=10485760

# Max messages sent to a newly joined client
MAX_HISTORY_SEND=500

# Min delay between on-demand older-history requests per session
# (/older). Separate from MESSAGE_COOLDOWN on purpose: each request
# scans and re-marshals up to a full window, so unthrottled spam is
# CPU amplification.
HISTORY_SEGMENT_COOLDOWN=2s

# On-demand older-history reads beyond RAM, by cost tier:
# 0 RAM-only (default) | 1 +active history.jsonl | 2 +.old raw |
# 3 +.old.zst archive (full, costs a streaming decode per request).
# Out-of-range values fall back to 0. Boot load and writes are
# unaffected: this gates only /older reads past the RAM window.
HISTORY_DISK_LOOKUP=0

# ======================== DEPLOY BIND ========================
# Host address the compose port binds to (compose interpolation, not
# read by the server itself). Loopback default isolates the app from
# the outside network: keep it for Tunnel setups. Set 0.0.0.0 only
# for direct exposure, behind a CF-whitelisted host firewall.
# Left commented on purpose: compose defaults to 127.0.0.1.
#BIND_ADDR=127.0.0.1

# ======================== WEB CLIENT ========================
# Serve the WASM web client at /web/. Master switch for every request;
# onion requests also need ONION_ALLOW_WEB (see below).
WEB_ENABLED=true

# ======================== TRUSTED PROXY ========================
# Explicit reverse-proxy chain (REQUIRED, no implicit default).
# Modules: none (direct, ignore all proxy headers), cloudflare
# (trust CF-Connecting-IP from configured edge ranges), direct
# (operator-owned IPs treated as direct, never read headers).
# Examples: "none" (no proxy), "cloudflare" (strict: reject direct),
# "cloudflare,direct" (CF plus listed direct IPs).
# "false" (the shipped value) means unconfigured: the boot fails on
# purpose until the operator states the chain explicitly.
# Missing or unknown value fails the boot on purpose.
PROXY_PROVIDER=false

# Directory of per-module "<name>.txt" trust files
# (cloudflare.txt, direct.txt). Only listed chain members load.
TRUSTED_PROXY_DIR=./config/trustedproxy

# ======================== ONION (TOR) ========================
# Onion hostnames accepted without TLS: Tor already provides end-to-end
# encryption and authenticates the .onion address, and no CA issues certs
# for .onion. Comma-separated "<id>.onion"; empty disables onion support.
# Requests are accepted only from loopback or from a hop listed in
# config/trustedproxy/onion.txt; a header-trusting proxy never qualifies.
# Every entry MUST end in ".onion" (boot fails otherwise). All onion
# clients share one abuse bucket (no client IP exists over Tor), so raise
# MAX_CONNECTIONS_PER_IP for onion deployments.
ONION_HOSTS=
# Serve the WASM web client to onion requests (default off: app.wasm is
# large over Tor). Enable only when the web client is actually wanted.
ONION_ALLOW_WEB=false
# Allow passkey (WebAuthn) from onion (default off: a passkey binds a single
# RPID/origin, so one server cannot serve clearnet and onion at once).
# Onion-only deployments may set WEBAUTHN_RPID/ORIGIN to the onion host and
# enable this.
ONION_ALLOW_PASSKEY=false

# ======================== WEBAUTHN PASSKEY ========================
# Real passkey login for web clients. Enabled when BOTH are set.
# RP ID binds credentials to this domain (use the exact host serving /web/)
WEBAUTHN_RPID=chat.example.com
# Origin checked during every ceremony (must match the page origin)
WEBAUTHN_ORIGIN=https://chat.example.com
# Ticket + credential store (server-managed, created automatically)
WEBAUTHN_STORE=./data/webauthn.json
