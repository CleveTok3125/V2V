# ======================== STATIC ========================
# Port the server listens on
PORT=10000

# Enforce wss:// (TLS) connections only. When this var is absent the
# server default is TRUE (fail-closed); set it to false explicitly to
# allow plaintext ws:// (e.g. localhost-only or onion-only deployments).
REQUIRE_TLS=true

# Allowed CORS origins (comma-separated). Origin is a browser-only
# header: the desktop client sends none, and the server allows that
# (Origin exists to stop a web page from hijacking a session, not to
# authenticate clients). A browser page's WebSocket handshake is
# rejected unless its Origin matches an entry here, so list every
# address the web client is served from. Browsers treat localhost and
# 127.0.0.1 as different origins, hence both loopback defaults (for the
# bundled webterm bundle or a first local run); they grant no access to
# outside pages. Add your real domain for production, e.g.
# https://chat.example.com — an entry accepts that origin only, so list
# exactly the hosts you serve the web client from.
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Unique identifier for this instance
INSTANCE_ID=your-instance-id

# Timezone for timestamps
TIMEZONE=Asia/Ho_Chi_Minh

# Data root for generated files (identity, webauthn store, history,
# log). Individual paths below still win when set. Defaults to
# <instance>/data when unset.
DATA_DIR=./data

# Log file path
LOG_FILE_PATH=./data/app.log

# Max log file size before rotation (MB)
MAX_LOG_SIZE_MB=50

# History file path (RFC3339Nano ts, wire JSON; .old is zstd-compressed to .old.zst)
HISTORY_FILE_PATH=./data/history.jsonl

# Max history file size before rotation (MB, raw; .old is zstd ~3MB for 50MB)
MAX_HISTORY_FILE_SIZE_MB=50

# ======================== CONTENT PRIVACY ========================
# NO_CONTENT_LOGS is a content-privacy policy, NOT "zero logs".
# true  -> chat history lives in RAM only (nothing is appended to
#          HISTORY_FILE_PATH, no rotation, no disk lookup) and message
#          content is never logged (no per-message line, rejected payloads
#          are logged by error type only).
#          Operational metadata is still logged to stdout/stderr: client
#          IP, auth/identity events, admin and error lines. Identity and
#          auth files are still written (server_identity.json,
#          webauthn.json, config/roles.json).
# false -> default: history persists to HISTORY_FILE_PATH and logs append
#          to LOG_FILE_PATH.
# LOG_FILE_PATH and HISTORY_FILE_PATH are ignored while this is true.
# Existing history/log files are left untouched: remove them manually, and
# disable log persistence at the OS level (e.g. journald) for a full
# no-content-retention deployment.
NO_CONTENT_LOGS=false

# ======================== DYNAMIC ========================
# The three URLs below only feed the status page. Optional: when one is
# empty its line is simply omitted (the server still boots).
# Public server status page
STATUS_URL=https://example.com/status

# Client download link
DOWNLOAD_URL=https://example.com/download

# Instance homepage
HOMEPAGE_URL=https://example.com/

# Max simultaneous connections per IP
MAX_CONNECTIONS_PER_IP=2

# Min delay between connections from the same IP
CONNECTION_COOLDOWN=5s

# Min delay between messages (anti-spam)
MESSAGE_COOLDOWN=200ms

# Disconnect clients that do not send any chat message for too long (0 to disable)
IDLE_CHAT_TIMEOUT=30m

# Max characters per message
MAX_MESSAGE_LENGTH=5000

# Max lines per message
MAX_MESSAGE_LINE=50

# Max display name length
MAX_USERNAME_LENGTH=12

# Max tripcode length
MAX_TRIPCODE_LENGTH=64

# Max chat history size in bytes (10 MB, in-memory ChatHistory, cap shrink when cap>4*len)
MAX_HISTORY_BYTES=10485760

# Max messages sent to a newly joined client
MAX_HISTORY_SEND=500

# Min delay between on-demand older-history requests per session
# (/older). Separate from MESSAGE_COOLDOWN on purpose: each request
# scans and re-marshals up to a full window, so unthrottled spam is
# CPU amplification.
HISTORY_SEGMENT_COOLDOWN=2s

# On-demand older-history reads beyond RAM, by cost tier:
# 0 RAM-only (default) | 1 +active history.jsonl | 2 +.old raw |
# 3 +.old.zst archive (full, costs a streaming decode per request).
# Out-of-range values fall back to 0. Boot load and writes are
# unaffected: this gates only /older reads past the RAM window.
HISTORY_DISK_LOOKUP=0

# ======================== DEPLOY BIND ========================
# Host address the compose port binds to (compose interpolation, not
# read by the server itself). Loopback default isolates the app from
# the outside network: keep it for Tunnel setups. Set 0.0.0.0 only
# for direct exposure, behind a CF-whitelisted host firewall.
# Left commented on purpose: compose defaults to 127.0.0.1.
#BIND_ADDR=127.0.0.1

# ======================== WEB CLIENT ========================
# Serve the WASM web client at /web/. Master switch for every request;
# onion requests also need ONION_ALLOW_WEB (see below).
WEB_ENABLED=true

# ======================== TRUSTED PROXY ========================
# Explicit reverse-proxy chain (REQUIRED, no implicit default).
# Modules: none (direct, ignore all proxy headers), cloudflare
# (trust CF-Connecting-IP from configured edge ranges), direct
# (operator-owned IPs treated as direct, never read headers).
# Examples: "none" (no proxy), "cloudflare" (strict: reject direct),
# "cloudflare,direct" (CF plus listed direct IPs).
# "false" (the shipped value) means unconfigured: the boot fails on
# purpose until the operator states the chain explicitly.
# Missing or unknown value fails the boot on purpose.
PROXY_PROVIDER=false

# Directory of per-module "<name>.txt" trust files
# (cloudflare.txt, direct.txt). Only listed chain members load.
TRUSTED_PROXY_DIR=./config/trustedproxy

# ======================== ONION (TOR) ========================
# Onion hostnames accepted without TLS: Tor already provides end-to-end
# encryption and authenticates the .onion address, and no CA issues certs
# for .onion. Comma-separated "<id>.onion"; empty disables onion support.
# Requests are accepted only from loopback or from a hop listed in
# config/trustedproxy/onion.txt; a header-trusting proxy never qualifies.
# Every entry MUST end in ".onion" (boot fails otherwise). All onion
# clients share one abuse bucket (no client IP exists over Tor), so raise
# MAX_CONNECTIONS_PER_IP for onion deployments.
ONION_HOSTS=
# Serve the WASM web client to onion requests (default off: app.wasm is
# large over Tor). Enable only when the web client is actually wanted.
ONION_ALLOW_WEB=false
# Allow passkey (WebAuthn) from onion (default off: a passkey binds a single
# RPID/origin, so one server cannot serve clearnet and onion at once).
# Onion-only deployments may set WEBAUTHN_RPID/ORIGIN to the onion host and
# enable this.
ONION_ALLOW_PASSKEY=false

# ======================== WEBAUTHN PASSKEY ========================
# Real passkey login for web clients. Enabled when BOTH are set.
# RP ID binds credentials to this domain (use the exact host serving /web/)
WEBAUTHN_RPID=chat.example.com
# Origin checked during every ceremony (must match the page origin)
WEBAUTHN_ORIGIN=https://chat.example.com
# Ticket + credential store (server-managed, created automatically)
WEBAUTHN_STORE=./data/webauthn.json

# ======================== ABUSE / UNDER-ATTACK ========================
# Global simultaneous-connection cap (always enforced, normal or attack).
# ServeWS answers 503+Retry-After past it; registerClient re-checks.
MAX_TOTAL_CONNECTIONS=500

# Reject non-IPv4 client addresses (IPv6) with 403.
REQUIRE_IPV4=false

# Operator IP/CIDR denylist (one per line, like trust files), matched
# before any rate limit. A missing file only warns; a malformed or
# world-writable file fails the boot.
BLOCKLIST_FILE=./config/blocklist.txt

# Enter under-attack after the cap holds for this long, or when the
# 5s reject rate passes ATTACK_ENTER_RPS. Hold UNDER_ATTACK_TTL once
# entered; hitting the cap again re-arms from that moment.
ATTACK_ENTER_SECS=5s
ATTACK_ENTER_RPS=50
UNDER_ATTACK_TTL=10m

# auto = state machine, on = always under attack, off = never.
UNDER_ATTACK_FORCE=auto

# ======================== POW ========================
# Pre-connect PoW: never (no gate), always (every new join), or only
# while under attack.
POW_FIRST_CONNECT=under-attack

# Fixed tier used for the gate when behavior scoring is off.
POW_GATE_TIER=1

# Tier count: P0 is the no-PoW tier, presets below cover 1..count-1.
POW_TIER_COUNT=4

# Per-tier argon2id cost (T/M/P, M in KiB) plus sha256 search width
# (leading zero bits) and the advertised solve budget in ms.
POW_P1_T=1
POW_P1_M=8192
POW_P1_P=1
POW_P1_DIFF=16
POW_P1_EST_MS=500
POW_P2_T=1
POW_P2_M=16384
POW_P2_P=1
POW_P2_DIFF=20
POW_P2_EST_MS=2000
POW_P3_T=1
POW_P3_M=32768
POW_P3_P=1
POW_P3_DIFF=24
POW_P3_EST_MS=8000

# Offer lifetime, join wait window and in-chat screening deadline.
POW_TTL=2m
JOIN_WAIT_MIN=30s
JOIN_WAIT_MAX=60s
SCREEN_DEADLINE=5m

# PoW gate for heavy HTTP endpoints while under attack. The pass is
# IP-bound with PASS_TTL and reusable (solving per request is absurd);
# single-use only spends it on the first WS join.
GATE_HTTP_ENABLED=true
GATE_HTTP_CLASSES=trip_verify,webauthn_begin,webauthn_finish
GATE_HTTP_MODE=under-attack
# tier mode only: gate a class once the requesting IP's behavior tier
# reaches this value (clean HTTP-only IPs count as tier 0).
GATE_HTTP_TIER_MIN=1
PASS_TTL=10m
PASS_SINGLE_USE=false

# ======================== BEHAVIOR ========================
# Master switch for behavior scoring and in-chat PoW. Default on; when
# false, no group key below is needed and in-chat PoW stays off.
BEHAVIOR_ENABLED=true

# Suspicion curve exponent (S = A^gamma): above 1 keeps low scores cheap.
BEHAVIOR_CURVE_GAMMA=1.5

# Sliding windows for rates (short: HTTP/churn) and long aggregates
# (slow spam), plus the max gap that still counts as one active run.
BEHAVIOR_WINDOW_SHORT=10m
BEHAVIOR_WINDOW_LONG=1h
BEHAVIOR_GAP_WINDOW=30m

# Local deep-night hours for the circadian feature.
BEHAVIOR_NIGHT_START=2
BEHAVIOR_NIGHT_END=5

# Suspicion value per identity kind: guests are cheap to mint, keys cost.
BEHAVIOR_IDENTITY_GUEST=0.5
BEHAVIOR_IDENTITY_TRIP=0.2
BEHAVIOR_IDENTITY_KEY=0.08

# Per-feature params: W (weight, 0 disables), NMIN (sample floor),
# RAMP_LO/HI (normalization bounds). Rhythm ramps down (low CV is bad);
# everything else ramps up.
BEHAVIOR_W_RHYTHM=0.18
BEHAVIOR_NMIN_RHYTHM=20
BEHAVIOR_RAMP_RHYTHM_LO=0.1
BEHAVIOR_RAMP_RHYTHM_HI=0.8
BEHAVIOR_W_THROUGHPUT=0.25
BEHAVIOR_NMIN_THROUGHPUT=10
BEHAVIOR_RAMP_THROUGHPUT_LO=20
BEHAVIOR_RAMP_THROUGHPUT_HI=200
BEHAVIOR_W_NIGHT=0.12
BEHAVIOR_NMIN_NIGHT=30
BEHAVIOR_RAMP_NIGHT_LO=0.05
BEHAVIOR_RAMP_NIGHT_HI=0.6
BEHAVIOR_W_CONTINUITY=0.12
BEHAVIOR_NMIN_CONTINUITY=10
BEHAVIOR_RAMP_CONTINUITY_LO=4
BEHAVIOR_RAMP_CONTINUITY_HI=16
BEHAVIOR_W_CHURN=0.10
BEHAVIOR_NMIN_CHURN=5
BEHAVIOR_RAMP_CHURN_LO=3
BEHAVIOR_RAMP_CHURN_HI=10
BEHAVIOR_W_IDENTITY=0.10
BEHAVIOR_NMIN_IDENTITY=1
BEHAVIOR_RAMP_IDENTITY_LO=0
BEHAVIOR_RAMP_IDENTITY_HI=1
BEHAVIOR_W_IPREP=0.15
BEHAVIOR_NMIN_IPREP=5
BEHAVIOR_RAMP_IPREP_LO=5
BEHAVIOR_RAMP_IPREP_HI=50
BEHAVIOR_W_PROTOERR=0.08
BEHAVIOR_NMIN_PROTOERR=1
BEHAVIOR_RAMP_PROTOERR_LO=0
BEHAVIOR_RAMP_PROTOERR_HI=5
BEHAVIOR_W_HTTP_RATE=0.10
BEHAVIOR_NMIN_HTTP_RATE=5
BEHAVIOR_RAMP_HTTP_RATE_LO=1
BEHAVIOR_RAMP_HTTP_RATE_HI=30
BEHAVIOR_W_HTTP_ERROR=0.10
BEHAVIOR_NMIN_HTTP_ERROR=5
BEHAVIOR_RAMP_HTTP_ERROR_LO=0
BEHAVIOR_RAMP_HTTP_ERROR_HI=1
BEHAVIOR_W_ENDPOINT_FOCUS=0.10
BEHAVIOR_NMIN_ENDPOINT_FOCUS=5
BEHAVIOR_RAMP_ENDPOINT_FOCUS_LO=0
BEHAVIOR_RAMP_ENDPOINT_FOCUS_HI=1
BEHAVIOR_W_AUTH_PROBE=0.10
BEHAVIOR_NMIN_AUTH_PROBE=1
BEHAVIOR_RAMP_AUTH_PROBE_LO=0
BEHAVIOR_RAMP_AUTH_PROBE_HI=5
BEHAVIOR_W_ENVELOPE=0.10
BEHAVIOR_NMIN_ENVELOPE=1
BEHAVIOR_RAMP_ENVELOPE_LO=0
BEHAVIOR_RAMP_ENVELOPE_HI=5

# Group suspicion weights by level (narrow groups weigh more) and the
# minimum member count before a group taints anyone.
BEHAVIOR_GROUP_BETA_IP=0.6
BEHAVIOR_GROUP_BETA_48=0.5
BEHAVIOR_GROUP_BETA_ASN=0.3
BEHAVIOR_GROUP_BETA_COUNTRY=0.2
BEHAVIOR_GROUP_MIN_MEMBERS=2

# Hysteresis thresholds per tier: ENTER_k > EXIT_k > ENTER_{k-1}.
BEHAVIOR_TIER1_ENTER=0.12
BEHAVIOR_TIER1_EXIT=0.08
BEHAVIOR_TIER2_ENTER=0.30
BEHAVIOR_TIER2_EXIT=0.24
BEHAVIOR_TIER3_ENTER=0.65
BEHAVIOR_TIER3_EXIT=0.55

# Randomized in-chat re-check cadence (uniform within the window).
POW_RECHECK_MIN=5m
POW_RECHECK_MAX=15m

# Message-driven re-score: re-arm scoring after this many messages
# since the last score, so short bursty sessions are re-scored instead
# of evaluated once at connect time.
BEHAVIOR_SCORE_EVERY_N_MSGS=20

# Attack scale: max or weighted mix of reject ratio, connection growth,
# distinct-IP growth and blocklist hits.
ATTACK_SCALE_MODE=max
ATTACK_SCALE_W_REJECT=1
ATTACK_SCALE_W_CONNRATE=1
ATTACK_SCALE_W_IPGROWTH=1
ATTACK_SCALE_W_BLOCKLIST=1

# Max extra tiers the attack bump may add (final tier still clamps).
ATTACK_TIER_BUMP_MAX=1

# Profile retention per tier: suspicious profiles outlive clean ones.
BEHAVIOR_RETENTION_P0=24h
BEHAVIOR_RETENTION_P1=72h
BEHAVIOR_RETENTION_P2=168h
BEHAVIOR_RETENTION_P3=720h

# Calibration histogram (aggregate tier counts, no per-IP data).
BEHAVIOR_STATS_ENABLED=true
BEHAVIOR_STATS_WINDOW=15m

# Optional GeoIP directory with GeoLite2-ASN.mmdb / GeoLite2-City.mmdb
# (or compatible DB-IP files renamed). Missing files only skip
# ASN/region grouping; the directory key itself is required.
BEHAVIOR_GEOIP_DIR=./config/geoip

# Behavior profile store (timing/count metadata only, never content).
BEHAVIOR_FILE_PATH=./data/behavior.jsonl
