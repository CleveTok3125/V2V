# --- WebAuthn Passkey (enabled when both are set) ---
# RP ID: the domain credentials bind to (use the specific sub-domain if the
# feature is only served there)
WEBAUTHN_RPID=chat.elsutm.io.vn
WEBAUTHN_ORIGIN=https://chat.elsutm.io.vn
# Where the server stores enrollment tickets and real-passkey credentials
WEBAUTHN_STORE=./data/webauthn.json
